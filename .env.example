CHAT_BASE_URL=https://llmapi.paratera.com/v1/
CHAT_MODEL=DeepSeek-V4.1-Flash-1017
EMBEDDING_API_KEY=
QWEN_MODEL_PATH=./models/Qwen3-8B
TINY_HOSPITAL_PYTHON=python
